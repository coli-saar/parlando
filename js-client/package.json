{
  "name": "@coli-saar/parlando-client",
  "version": "0.1.2",
  "type": "module",
  "description": "Reusable browser client SDK for Parlando experiment games.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./livekit": {
      "types": "./dist/livekit.d.ts",
      "import": "./dist/livekit.js"
    },
    "./speechmatics": {
      "types": "./dist/speechmatics.d.ts",
      "import": "./dist/speechmatics.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run src",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "livekit-client": "^2.20.1",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "livekit-client": "^2.20.1",
    "react": "^19.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
