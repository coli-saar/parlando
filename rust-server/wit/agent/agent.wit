package parlando:agent@1.0.0;

/// An isolated policy controlling one player in one game.
interface policy {
    enum role { a, b }

    record transition {
        actor: role,
        action: list<u8>,
        view: list<u8>,
    }

    record message {
        sender: role,
        text: string,
    }

    record observation {
        transition: option<transition>,
        message: option<message>,
    }

    record duration {
        seconds: u64,
        nanoseconds: u32,
    }

    variant wakeup-request {
        after(duration),
        cancel,
    }

    record response {
        action: option<list<u8>>,
        message: option<string>,
        wakeup: option<wakeup-request>,
    }

    variant respond-reason {
        session-started,
        after-observation,
        scheduled,
        wakeup-due,
        action-rejected(string),
    }

    /// Returns the static definition, release identity, and game payload declarations as JSON.
    describe: func() -> result<string, string>;
    /// Starts the policy with named MessagePack settings and a recorded random seed.
    init: func(config: list<u8>, role: role, seed: u64) -> result<_, string>;
    /// Delivers the first compact role-private view.
    start: func(view: list<u8>) -> result<_, string>;
    /// Delivers accepted game and message events in one ordered observation.
    observe: func(event: observation) -> result<_, string>;
    /// Requests one discrete policy decision.
    respond: func(reason: respond-reason) -> result<response, string>;
    /// Delivers the game's compact completion value.
    finish: func(completion: list<u8>) -> result<_, string>;
    /// Releases the session's resources.
    shutdown: func() -> result<_, string>;
}

world agent {
    export policy;
}
